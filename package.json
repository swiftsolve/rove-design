{
  "name": "@swiftsolve/rove-design",
  "version": "4.0.0",
  "description": "Rove's design tokens, exported from the Rove Design System in Figma, as CSS and DTCG.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/swiftsolve/rove-design.git"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "tokens",
    "figma/variables.json",
    "figma/text-styles.json",
    "code-tokens.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "present": "npm run build && node scripts/present.mjs",
    "present:open": "node scripts/open-presentation.mjs",
    "present:publish": "node scripts/publish-presentation.mjs",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  }
}

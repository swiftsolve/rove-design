{
  "name": "@swiftsolve/rove-design",
  "version": "5.3.0",
  "description": "Rove's design tokens, exported from the Rove Design System in Figma, as CSS and DTCG.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftsolve/rove-design.git"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens.css",
    "tokens",
    "src",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "node scripts/tokens/build.mjs",
    "present": "npm run build && node scripts/presentation/export.mjs",
    "present:open": "node scripts/presentation/open.mjs",
    "present:publish": "node scripts/presentation/publish.mjs",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.1"
  }
}

{
  "$description": "Tokens that Figma variables can't hold: composite shadows, font stacks, layout constants and motion. `{figma/name}` pulls a Figma variable's raw value in for each theme.",
  "skip": [
    "focus/ring",
    "shadow/panel-1",
    "shadow/panel-2",
    "shadow/raised",
    "font-family/sans",
    "font-family/numeric"
  ],
  "formats": {
    "--opacity-disabled": "fraction"
  },
  "tokens": {
    "--shadow-panel": "0 1px 2px {shadow/panel-1}, 0 4px 12px {shadow/panel-2}",
    "--shadow-raised": "0 12px 32px {shadow/raised}",

    "--focus-ring-width": "1px",
    "--focus-ring": "var(--focus-ring-width) solid var(--accent)",
    "--focus-inset": "calc(-1 * var(--focus-ring-width))",

    "--section-header-y": "var(--section-pad)",
    "--section-header-x": "var(--section-pad)",
    "--section-header-min": "42px",
    "--section-header-h": "44px",
    "--section-body": "var(--section-pad)",
    "--row-py": "8px",

    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "--duration-fast": "140ms",
    "--duration-normal": "220ms",

    "--font": "'{font-family/sans}', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--font-numeric": "'{font-family/numeric}', ui-sans-serif, system-ui, sans-serif",
    "--font-mono": "var(--font-numeric)",
    "--text-display-sm": "28px",

    "--weight-regular": "400",
    "--weight-medium": "500",
    "--weight-semibold": "600"
  }
}
